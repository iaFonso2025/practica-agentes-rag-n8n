    {
      "parameters": {
        "jsCode": "const salida = [];\n\n// Recorremos todos los documentos que llegan (normalmente 1, pero pueden ser varios)\nfor (let i = 0; i < $input.all().length; i++) {\n\n  const texto = $('Extract from File').itemMatching(i).json.text;   // texto del PDF nº i\n  const fila  = $('Get row(s) in sheet').itemMatching(i).json;       // su fila del catálogo\n\n  const trozos = texto.split(/\\n(?=\\d+\\.\\s)/);\n\n  for (const t of trozos) {\n    salida.push({\n  json: { ...fila, text: t.trim(), seccion: t.trim().split('\\n')[0] },\n  pairedItem: i      // ← este trozo viene del documento nº i\n});\n  }\n}\n\nreturn salida;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
